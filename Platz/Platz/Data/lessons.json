    {
        "id": "lesson_alpha_01",
        "track": "alphabet",
        "title": "독일어 알파벳 소개",
        "level": "a1",
        "durationMin": 5,
        "order": 1,
        "contentMarkdown": "독일어 알파벳은 영어와 거의 같지만, 4개의 특수문자가 추가됩니다:\n\n- Ä, ä (A-움라우트)\n- Ö, ö (O-움라우트)\n- Ü, ü (U-움라우트)\n- ß (에스체트, 날카로운 S)",
        "examples": [
            {
                "de": "Ä",
                "ko": "에(ㅔ에 가까운 소리)",
                "pronunciation": "에",
                "note": "입을 '에' 모양으로"
            },
            {
                "de": "Ö",
                "ko": "외(ㅚ에 가까운 소리)",
                "pronunciation": "외",
                "note": "입을 '오' 모양으로 하고 '에' 발음"
            },
            {
                "de": "Ü",
                "ko": "위(ㅟ에 가까운 소리)",
                "pronunciation": "위",
                "note": "입을 '우' 모양으로 하고 '이' 발음"
            },
            {
                "de": "ß",
                "ko": "ss (날카로운 S)",
                "pronunciation": "스",
                "note": "영어 'ss'와 같음"
            }
        ],
        "tips": [
            "움라우트(Umlaut)는 모음 위의 두 점을 말합니다",
            "ß는 스위스에서는 사용하지 않습니다"
        ],
        "miniQuizId": "quiz_alpha_01"
    },

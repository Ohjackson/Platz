    {
        "id": "dialog_train_01",
        "topic": "train",
        "title": "기차표 예매",
        "description": "기차역 창구에서 표를 사는 상황",
        "order": 10,
        "lines": [
            {
                "speaker": "A",
                "de": "Einmal nach München, bitte.",
                "ko": "뮌헨행 표 한 장 주세요.",
                "note": "Einmal = one ticket (구어체)"
            },
            {
                "speaker": "B",
                "de": "Einfach oder hin und zurück?",
                "ko": "편도인가요, 왕복인가요?",
                "note": null
            },
            {
                "speaker": "A",
                "de": "Hin und zurück, bitte.",
                "ko": "왕복으로 주세요.",
                "note": null
            },
            {
                "speaker": "B",
                "de": "Das kostet 80 Euro. Haben Sie eine BahnCard?",
                "ko": "80유로입니다. 반카드(할인카드) 있으신가요?",
                "note": null
            },
            {
                "speaker": "A",
                "de": "Nein, habe ich nicht.",
                "ko": "아뇨, 없어요.",
                "note": null
            }
        ],

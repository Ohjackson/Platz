    {
        "id": "dialog_a2_appointment_01",
        "topic": "appointment",
        "title": "약속 시간 변경",
        "description": "친구와의 약속 시간을 정중하게 바꾸는 상황",
        "level": "a2",
        "order": 1,
        "lines": [
            {
                "speaker": "A",
                "de": "Hallo Max, hast du morgen Nachmittag Zeit?",
                "ko": "안녕 막스, 내일 오후에 시간 있어?",
                "note": null
            },
            {
                "speaker": "B",
